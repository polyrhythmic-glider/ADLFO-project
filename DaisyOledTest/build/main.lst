 188:../../DaisyExamples/libDaisy/src/hid/disp/display.h **** /** This class is intended as a intermediary class for your actual implementation of the OneBitGrap
 189:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  interface. It uses the CRTP design pattern where the template argument is the child class. It p
 190:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  implementations for most of the functions, except DrawPixel(), Update() and Fill(), which you'l
ARM GAS  /tmp/ccxQiFiw.s 			page 20


 191:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  to provide in your child class.
 192:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  The main goal of this class is to provide common drawing functions without relying on massive a
 193:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  virtual function calls that would result in a performance loss. To achieve this, any drawing fu
 194:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  is implemented here and internally calls other drawing functions (e.g. DrawRect() which interna
 195:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  DrawPixel() and DrawLine()) makes these calls via the qualified name of these functions to expl
 196:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  suppress the virtual dispatch mechanism like this:
 197:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  * 
 198:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *      ChildType::DrawPixel(...); // no virtual function call; direct call into the child class fu
 199:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  
 200:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  To create a custom OneBitGraphicsDisplay implementation, you can 
 201:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  A) inherit from OneBitGraphicsDisplay directly and provide all the drawing functions yourself
 202:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  B) Inherit from OneBitGraphicsDisplayImpl and only provide DrawPixel(), Fill() and Update()
 203:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *     like this:
 204:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  
 205:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *      class MyDisplayClass : public OneBitGraphicsDisplayImpl<MyDisplayClass> 
 206:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *      {
 207:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *      public:
 208:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *          void Fill() override { ... };
 209:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *          void DrawPixel(uint_fast8_t x, uint_fast8_t y, bool on) override { ... };
 210:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *          void Update() override { ... }
 211:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *      };
 212:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  *  
 213:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****  */
