 211:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****   private:
 212:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****     void SoftSpiTransmit(uint8_t val)
 213:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****     {
 214:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****         // bit flip
 215:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****         val = ((val & 0x01) << 7) | ((val & 0x02) << 5) | ((val & 0x04) << 3)
 216:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****               | ((val & 0x08) << 1) | ((val & 0x10) >> 1) | ((val & 0x20) >> 3)
 217:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****               | ((val & 0x40) >> 5) | ((val & 0x80) >> 7);
 218:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h **** 
 219:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****         for(uint8_t bit = 0u; bit < 8u; bit++)
 220:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****         {
 221:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****             dsy_gpio_write(&pin_mosi_, ((val & (1 << bit)) ? 1 : 0));
 222:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h **** 
 223:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****             System::DelayTicks(clk_delay);
 224:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h **** 
 225:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****             dsy_gpio_toggle(&pin_sclk_);
 226:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h **** 
 227:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****             System::DelayTicks(clk_delay);
 228:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h **** 
 229:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****             dsy_gpio_toggle(&pin_sclk_);
 230:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****         }
 231:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****     }
 232:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h **** 
 233:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****     uint32_t clk_delay;
 234:../../DaisyExamples/libDaisy/src/dev/oled_ssd130x.h ****     dsy_gpio pin_sclk_;
