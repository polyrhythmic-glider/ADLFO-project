 221:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     void DrawLine(uint_fast8_t x1,
 222:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                   uint_fast8_t y1,
 223:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                   uint_fast8_t x2,
 224:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                   uint_fast8_t y2,
 225:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                   bool         on) override
 226:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     {
 227:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         int_fast16_t deltaX = abs((int_fast16_t)x2 - (int_fast16_t)x1);
 228:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         int_fast16_t deltaY = abs((int_fast16_t)y2 - (int_fast16_t)y1);
 229:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         int_fast16_t signX  = ((x1 < x2) ? 1 : -1);
 230:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         int_fast16_t signY  = ((y1 < y2) ? 1 : -1);
 231:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         int_fast16_t error  = deltaX - deltaY;
 232:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         int_fast16_t error2;
 233:../../DaisyExamples/libDaisy/src/hid/disp/display.h **** 
 234:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         // If we write "ChildType::DrawPixel(x2, y2, on);", we end up with
 235:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         // all sorts of weird compiler errors when the Child class is a template
 236:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         // class. The only way around this is to use this very verbose syntax:
 237:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         ((ChildType*)(this))->ChildType::DrawPixel(x2, y2, on);
 238:../../DaisyExamples/libDaisy/src/hid/disp/display.h **** 
 239:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         while((x1 != x2) || (y1 != y2))
 240:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         {
 241:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             ((ChildType*)(this))->ChildType::DrawPixel(x1, y1, on);
 242:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             error2 = error * 2;
 243:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             if(error2 > -deltaY)
 244:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             {
 245:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                 error -= deltaY;
 246:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                 x1 += signX;
 247:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             }
 248:../../DaisyExamples/libDaisy/src/hid/disp/display.h **** 
 249:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             if(error2 < deltaX)
 250:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             {
 251:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                 error += deltaX;
 252:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                 y1 += signY;
 253:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             }
 254:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         }
 255:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     }
