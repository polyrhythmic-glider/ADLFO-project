 215:main.cpp      ****         case CurveType::Logarithmic: return "LOG";
 216:main.cpp      ****         case CurveType::Linear: return "LIN";
 217:main.cpp      ****         case CurveType::Exponential: return "EXP";
 218:main.cpp      ****     }
 219:main.cpp      **** 
 220:main.cpp      ****     return "?";
 221:main.cpp      **** }
