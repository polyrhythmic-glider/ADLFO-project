 203:main.cpp      **** float TimeFromNormalized(float normalized)
 204:main.cpp      **** {
 205:main.cpp      ****     normalized = daisysp::fclamp(normalized, 0.0f, 1.0f);
 206:main.cpp      ****     const float ratio = Settings::kMaximumTimeSeconds
 207:main.cpp      ****                         / Settings::kMinimumTimeSeconds;
 208:main.cpp      ****     return Settings::kMinimumTimeSeconds * std::pow(ratio, normalized);
 209:main.cpp      **** }
