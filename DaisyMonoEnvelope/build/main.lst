 294:main.cpp      ****         = application.normalized_cv * Settings::kCvTimeDepth;
 295:main.cpp      ****     const float rise_position = daisysp::fclamp(
 296:main.cpp      ****         application.rise_normalized + time_cv_offset
 297:main.cpp      ****             + symmetry * Settings::kSymmetryDepth,
 298:main.cpp      ****         0.0f,
 299:main.cpp      ****         1.0f);
 300:main.cpp      ****     const float fall_position = daisysp::fclamp(
 301:main.cpp      ****         application.fall_normalized + time_cv_offset
 302:main.cpp      ****             - symmetry * Settings::kSymmetryDepth,
 303:main.cpp      ****         0.0f,
 304:main.cpp      ****         1.0f);
 305:main.cpp      **** 
 306:main.cpp      ****     application.effective_rise_seconds = TimeFromNormalized(rise_position);
 307:main.cpp      ****     application.effective_fall_seconds = TimeFromNormalized(fall_position);
 308:main.cpp      **** 
 309:main.cpp      ****     ScopedIrqBlocker irq_blocker;
 310:main.cpp      ****     application.envelope.SetRiseTime(application.effective_rise_seconds);
 311:main.cpp      ****     application.envelope.SetFallTime(application.effective_fall_seconds);
 312:main.cpp      **** }
