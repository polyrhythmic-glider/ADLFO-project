 226:main.cpp      ****     {
 227:main.cpp      ****         case CurveType::Logarithmic:
 228:main.cpp      ****             application.curve = CurveType::Linear;
 229:main.cpp      ****             break;
 230:main.cpp      ****         case CurveType::Linear:
 231:main.cpp      ****             application.curve = CurveType::Exponential;
 232:main.cpp      ****             break;
 233:main.cpp      ****         case CurveType::Exponential:
 234:main.cpp      ****             application.curve = CurveType::Logarithmic;
 235:main.cpp      ****             break;
 236:main.cpp      ****     }
 237:main.cpp      **** 
 238:main.cpp      ****     // Il timer può leggere l'inviluppo in qualsiasi istante; il breve blocco
 239:main.cpp      ****     // IRQ rende atomico l'aggiornamento dei suoi parametri.
 240:main.cpp      ****     ScopedIrqBlocker irq_blocker;
 241:main.cpp      ****     application.envelope.SetCurve(application.curve);
 242:main.cpp      **** }
