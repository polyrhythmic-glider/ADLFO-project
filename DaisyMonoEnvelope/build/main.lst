 288:main.cpp      **** void UpdateEnvelopeTimes(Application& application)
 289:main.cpp      **** {
 290:main.cpp      ****     // Il potenziometro sposta Rise e Fall in direzioni opposte nel dominio
 291:main.cpp      ****     // normalizzato. Al centro (symmetry == 0) i tempi base non cambiano.
 292:main.cpp      ****     const float symmetry = (application.smoothed_pot - 0.5f) * 2.0f;
