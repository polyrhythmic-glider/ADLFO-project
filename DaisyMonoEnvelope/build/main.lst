  77:main.cpp      **** 
  78:main.cpp      **** // Il transport SSD1306 standard della versione locale di libDaisy invia ogni
  79:main.cpp      **** // byte con una transazione separata. Questo transport mantiene lo stesso
  80:main.cpp      **** // driver, ma invia una pagina da 128 byte per transazione: il refresh OLED non
  81:main.cpp      **** // monopolizza più il loop dei controlli.
  82:main.cpp      **** class BufferedSSD1306I2CTransport
  83:main.cpp      **** {
  84:main.cpp      ****   public:
  85:main.cpp      ****     struct Config
  86:main.cpp      ****     {
  87:main.cpp      ****         Config()
  88:main.cpp      ****         {
  89:main.cpp      ****             i2c_config.periph = I2CHandle::Config::Peripheral::I2C_1;
  90:main.cpp      ****             i2c_config.speed = I2CHandle::Config::Speed::I2C_400KHZ;
  91:main.cpp      ****             i2c_config.mode = I2CHandle::Config::Mode::I2C_MASTER;
  92:main.cpp      ****             i2c_config.pin_config.scl = HardwarePins::I2cScl;
  93:main.cpp      ****             i2c_config.pin_config.sda = HardwarePins::I2cSda;
  94:main.cpp      ****             i2c_address = Settings::kOledI2cAddress;
  95:main.cpp      ****         }
  96:main.cpp      **** 
  97:main.cpp      ****         I2CHandle::Config i2c_config;
  98:main.cpp      ****         uint8_t i2c_address;
  99:main.cpp      ****     };
 100:main.cpp      **** 
 101:main.cpp      ****     void Init(const Config& config)
 102:main.cpp      ****     {
 103:main.cpp      ****         i2c_address_ = config.i2c_address;
 104:main.cpp      ****         i2c_.Init(config.i2c_config);
 105:main.cpp      ****     }
 106:main.cpp      **** 
 107:main.cpp      ****     void SendCommand(uint8_t command)
 108:main.cpp      ****     {
 109:main.cpp      ****         uint8_t packet[2] = {0x00, command};
 110:main.cpp      ****         i2c_.TransmitBlocking(i2c_address_, packet, 2, 100);
 111:main.cpp      ****     }
 112:main.cpp      **** 
 113:main.cpp      ****     void SendData(uint8_t* data, size_t size)
 114:main.cpp      ****     {
 115:main.cpp      ****         constexpr size_t kMaximumPageSize = 128;
 116:main.cpp      ****         if(size > kMaximumPageSize)
 117:main.cpp      ****             return;
 118:main.cpp      **** 
 119:main.cpp      ****         uint8_t packet[kMaximumPageSize + 1];
 120:main.cpp      ****         packet[0] = 0x40;
 121:main.cpp      ****         for(size_t index = 0; index < size; ++index)
 122:main.cpp      ****             packet[index + 1] = data[index];
 123:main.cpp      **** 
 124:main.cpp      ****         i2c_.TransmitBlocking(
 125:main.cpp      ****             i2c_address_, packet, static_cast<uint16_t>(size + 1), 100);
 126:main.cpp      ****     }
 127:main.cpp      **** 
 128:main.cpp      ****   private:
 129:main.cpp      ****     I2CHandle i2c_;
 130:main.cpp      ****     uint8_t i2c_address_ = Settings::kOledI2cAddress;
 131:main.cpp      **** };
 132:main.cpp      **** 
