 272:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             }
 273:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         }
 274:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         else
 275:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         {
 276:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             ((ChildType*)(this))->ChildType::DrawLine(x1, y1, x2, y1, on);
