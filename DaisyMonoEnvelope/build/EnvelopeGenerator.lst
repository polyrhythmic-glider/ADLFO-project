  31:EnvelopeGenerator.cpp **** void EnvelopeGenerator::Trigger()
  32:EnvelopeGenerator.cpp **** {
  33:EnvelopeGenerator.cpp ****     // In LFO il trigger riporta il ciclo all'inizio, utile per sincronizzarlo.
  34:EnvelopeGenerator.cpp ****     // In AD è accettato solo da Idle: un ciclo già in corso non viene interrotto.
  35:EnvelopeGenerator.cpp ****     if(cycling_)
  36:EnvelopeGenerator.cpp ****     {
  37:EnvelopeGenerator.cpp ****         stage_ = Stage::Rise;
  38:EnvelopeGenerator.cpp ****         phase_ = 0.0f;
  39:EnvelopeGenerator.cpp ****         value_ = 0.0f;
  40:EnvelopeGenerator.cpp ****     }
  41:EnvelopeGenerator.cpp ****     else if(stage_ == Stage::Idle)
  42:EnvelopeGenerator.cpp ****     {
  43:EnvelopeGenerator.cpp ****         stage_ = Stage::Rise;
  44:EnvelopeGenerator.cpp ****         phase_ = 0.0f;
  45:EnvelopeGenerator.cpp ****         value_ = 0.0f;
  46:EnvelopeGenerator.cpp ****     }
  47:EnvelopeGenerator.cpp **** }
  48:EnvelopeGenerator.cpp **** 
  49:EnvelopeGenerator.cpp **** void EnvelopeGenerator::SetCycling(bool enabled)
  50:EnvelopeGenerator.cpp **** {
  51:EnvelopeGenerator.cpp ****     if(enabled == cycling_)
  52:EnvelopeGenerator.cpp ****         return;
  53:EnvelopeGenerator.cpp **** 
  54:EnvelopeGenerator.cpp ****     cycling_ = enabled;
  55:EnvelopeGenerator.cpp ****     phase_   = 0.0f;
  56:EnvelopeGenerator.cpp ****     value_   = 0.0f;
  57:EnvelopeGenerator.cpp **** 
  58:EnvelopeGenerator.cpp ****     // Entrando in LFO si parte subito da zero. Tornando in AD si forza Idle.
  59:EnvelopeGenerator.cpp ****     stage_ = cycling_ ? Stage::Rise : Stage::Idle;
  60:EnvelopeGenerator.cpp **** }
  61:EnvelopeGenerator.cpp **** 
  62:EnvelopeGenerator.cpp **** void EnvelopeGenerator::SetRiseTime(float seconds)
  63:EnvelopeGenerator.cpp **** {
  64:EnvelopeGenerator.cpp ****     rise_time_ = seconds > kMinimumStageTime ? seconds : kMinimumStageTime;
  65:EnvelopeGenerator.cpp ****     rise_phase_increment_ = 1.0f / (rise_time_ * update_rate_);
  66:EnvelopeGenerator.cpp **** }
  67:EnvelopeGenerator.cpp **** 
  68:EnvelopeGenerator.cpp **** void EnvelopeGenerator::SetFallTime(float seconds)
  69:EnvelopeGenerator.cpp **** {
  70:EnvelopeGenerator.cpp ****     fall_time_ = seconds > kMinimumStageTime ? seconds : kMinimumStageTime;
  71:EnvelopeGenerator.cpp ****     fall_phase_increment_ = 1.0f / (fall_time_ * update_rate_);
  72:EnvelopeGenerator.cpp **** }
