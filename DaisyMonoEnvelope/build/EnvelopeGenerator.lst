  78:EnvelopeGenerator.cpp **** 
  79:EnvelopeGenerator.cpp **** float EnvelopeGenerator::Process()
  80:EnvelopeGenerator.cpp **** {
  81:EnvelopeGenerator.cpp ****     switch(stage_)
  82:EnvelopeGenerator.cpp ****     {
  83:EnvelopeGenerator.cpp ****         case Stage::Idle:
  84:EnvelopeGenerator.cpp ****             value_ = 0.0f;
  85:EnvelopeGenerator.cpp ****             break;
  86:EnvelopeGenerator.cpp **** 
  87:EnvelopeGenerator.cpp ****         case Stage::Rise:
  88:EnvelopeGenerator.cpp ****         {
  89:EnvelopeGenerator.cpp ****             // L'incremento è precomputato quando cambia il tempo: nel callback
  90:EnvelopeGenerator.cpp ****             // restano soltanto curve, somme e confronti. Rise parte da zero.
  91:EnvelopeGenerator.cpp ****             value_ = ApplyCurve(phase_);
  92:EnvelopeGenerator.cpp ****             phase_ += rise_phase_increment_;
  93:EnvelopeGenerator.cpp **** 
  94:EnvelopeGenerator.cpp ****             if(phase_ >= 1.0f)
  95:EnvelopeGenerator.cpp ****             {
  96:EnvelopeGenerator.cpp ****                 // Fall con fase zero produrrà esattamente il picco 1.0.
  97:EnvelopeGenerator.cpp ****                 phase_ = 0.0f;
  98:EnvelopeGenerator.cpp ****                 stage_ = Stage::Fall;
  99:EnvelopeGenerator.cpp ****             }
 100:EnvelopeGenerator.cpp ****         }
 101:EnvelopeGenerator.cpp ****         break;
 102:EnvelopeGenerator.cpp **** 
 103:EnvelopeGenerator.cpp ****         case Stage::Fall:
 104:EnvelopeGenerator.cpp ****         {
 105:EnvelopeGenerator.cpp ****             // Fall usa l'inverso della stessa curva crescente selezionata.
 106:EnvelopeGenerator.cpp ****             value_ = 1.0f - ApplyCurve(phase_);
 107:EnvelopeGenerator.cpp ****             phase_ += fall_phase_increment_;
 108:EnvelopeGenerator.cpp **** 
 109:EnvelopeGenerator.cpp ****             if(phase_ >= 1.0f)
 110:EnvelopeGenerator.cpp ****             {
 111:EnvelopeGenerator.cpp ****                 phase_ = 0.0f;
 112:EnvelopeGenerator.cpp ****                 value_ = 0.0f;
 113:EnvelopeGenerator.cpp ****                 stage_ = cycling_ ? Stage::Rise : Stage::Idle;
 114:EnvelopeGenerator.cpp ****             }
 115:EnvelopeGenerator.cpp ****         }
 116:EnvelopeGenerator.cpp ****         break;
 117:EnvelopeGenerator.cpp ****     }
 118:EnvelopeGenerator.cpp **** 
 119:EnvelopeGenerator.cpp ****     return Clamp01(value_);
 120:EnvelopeGenerator.cpp **** }
